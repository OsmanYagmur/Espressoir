{
  "name": "espressoir",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@espressoir/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @espressoir/web test:e2e",
    "test:e2e:offline": "tsx scripts/offline-snapshot.ts --file scripts/notion/fixtures/sample-export.csv && ARCHIVE_SNAPSHOT=1 pnpm --filter @espressoir/web build && ARCHIVE_SNAPSHOT=1 pnpm --filter @espressoir/web test:e2e",
    "check": "turbo run lint typecheck test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:new": "supabase migration new",
    "db:push:dev": "tsx scripts/db-push.ts --env dev",
    "db:push:prod": "tsx scripts/db-push.ts --env prod",
    "types:gen": "tsx scripts/gen-types.ts",
    "tokens:gen": "tsx scripts/gen-tokens.ts",
    "import:notion": "tsx scripts/import-notion.ts",
    "seed:dev": "tsx scripts/import-notion.ts --env dev --file scripts/notion/fixtures/sample-export.csv",
    "admin:bootstrap": "tsx scripts/admin-bootstrap.ts",
    "user:invite": "tsx scripts/user-invite.ts",
    "media:sweep": "tsx scripts/media-sweep.ts",
    "export:analytics": "tsx scripts/export-analytics.ts",
    "import:recommendations": "tsx scripts/import-recommendations.ts",
    "snapshot:offline": "tsx scripts/offline-snapshot.ts",
    "dev:offline": "pnpm snapshot:offline && ARCHIVE_SNAPSHOT=1 turbo run dev --filter=@espressoir/web"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "supabase": "^2.120.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3"
  }
}
