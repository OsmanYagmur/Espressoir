{
  "name": "@espressoir/mobile",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "env": "node scripts/write-env.mjs",
    "start": "node scripts/write-env.mjs && react-native start",
    "ios": "node scripts/write-env.mjs && react-native run-ios",
    "ios:device": "node scripts/ios-device.mjs",
    "pods": "cd ios && pod install",
    "lint": "eslint .",
    "typecheck": "node scripts/write-env.mjs && tsc --noEmit",
    "bundle": "node scripts/write-env.mjs && react-native bundle --platform ios --dev false --entry-file index.js --bundle-output dist/main.jsbundle --assets-dest dist"
  },
  "dependencies": {
    "@espressoir/core": "workspace:*",
    "@espressoir/db": "workspace:*",
    "@espressoir/i18n": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@supabase/supabase-js": "^2.117.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-get-random-values": "^2.0.0",
    "react-native-image-picker": "^8.3.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-webview": "13.16.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-export-namespace-from": "^7.29.7",
    "@babel/runtime": "^7.29.10",
    "@espressoir/config": "workspace:*",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@react-native/typescript-config": "0.86.3",
    "@types/react": "^19.3.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^9.39.5",
    "typescript": "^5.9.3"
  }
}
