# Copy to .env (git-ignored). Public values only: the same ones the website shows the browser.
# Development: the dev Supabase project and any deployment of the site (a preview works).
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The website: the app opens its /uygulama/dogrulama page for the sign-in CAPTCHA.
EXPO_PUBLIC_SITE_URL=https://espressoir.com
