# Copy to .env (git-ignored). Public values only: the same ones the website shows the browser.
# They are built into the app: change them, then build again (pnpm ios / ios:device).
# Real use: the prod Supabase project. Trying things out: the dev project.
APP_SUPABASE_URL=https://<project-ref>.supabase.co
APP_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The website (never localhost: on a phone that is the phone itself). The app opens its
# /uygulama/dogrulama page for the sign-in CAPTCHA and asks it to refresh after a save.
APP_SITE_URL=https://espressoir.com
