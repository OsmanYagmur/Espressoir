{
  "expo": {
    "name": "Espressoir",
    "slug": "espressoir",
    "scheme": "espressoir",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "backgroundColor": "#F4F4F1",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.espressoir.app",
      "appleTeamId": "X7AATGWM6G"
    },
    "android": {
      "package": "com.espressoir.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F4F1"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Tadımına fotoğraf eklemek için fotoğraflarına erişmek istiyoruz.",
          "cameraPermission": "Tadımının fotoğrafını çekmek için kamerana erişmek istiyoruz.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      "./plugins/with-scene-lifecycle"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
