# Copy to .env.local (dev project) — and to .env.prod.local with the prod project's values.
# Both files are git-ignored. Setup guide: docs/setup-supabase.md
#
# Why .env.prod.local and not .env.production.local? Next.js loads the latter automatically
# in production builds, so a local `pnpm build` would silently point at the live database.

# ── Web app (Vercel: Production = prod values, Preview/Development = dev values) ──
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Sign-in options (docs/setup-auth.md). These only shape the login form; the switches that
# decide live in the Supabase project's Auth settings and must agree with them.
# "true" once Supabase accepts new accounts; until then people join by invitation.
NEXT_PUBLIC_SIGNUP_ENABLED=false
# "true" once the Google provider is configured in Supabase.
NEXT_PUBLIC_AUTH_GOOGLE=false
# Cloudflare Turnstile site key; set it exactly when CAPTCHA protection is on in Supabase.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional absolute site URL for metadata/OG images. Leave empty on Vercel (detected automatically).
NEXT_PUBLIC_SITE_URL=

# ── Scripts only: never put these in Vercel, never prefix with NEXT_PUBLIC_ ──
SUPABASE_SECRET_KEY=sb_secret_...
# Dashboard → Connect → "Session pooler" URI (IPv4). Percent-encode special characters in the password.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
# Safety rails: scripts refuse to run when the DB URL does not match the expected project.
SUPABASE_DEV_PROJECT_REF=
SUPABASE_PROD_PROJECT_REF=
# Owner account (yours): Notion imports are assigned to this username.
OWNER_USERNAME=
OWNER_EMAIL=
